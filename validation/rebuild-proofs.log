theorem OrderedMatrixRemoval4.Host.all_copy_localization : ∀ (h : ℕ),
  1 ≤ h → ∀ (rows cols : Fin 4 → Fin (size h)), Copy h rows cols → sparseZero h (rows 2) (cols 3) :=
fun h _hh rows cols hc =>
  if ha : Anchor (labelAt true h (cols 1)) then canonical_copy_localization h rows cols hc ha
  else
    have hn :=
      Position.casesOn (motive := fun t => labelAt true h (cols 1) = t → Nonanchor (labelAt true h (cols 1)))
        (labelAt true h (cols 1))
        (fun level kind group clone h_1 =>
          Eq.ndrec (motive := fun x => labelAt true h (cols 1) = x → Nonanchor x)
            (fun he =>
              False.elim
                (Eq.mp
                  (Eq.trans
                    (congrArg Not
                      (congrArg
                        (fun x =>
                          match x with
                          | Position.anchor level kind group clone => True
                          | x => False)
                        he))
                    not_true_eq_false)
                  ha))
            (Eq.symm h_1) (Eq.refl (labelAt true h (cols 1))))
        (fun depth plus node clone h_1 =>
          Eq.ndrec (motive := fun x => labelAt true h (cols 1) = x → Nonanchor x) (fun he => True.intro) (Eq.symm h_1)
            (Eq.refl (labelAt true h (cols 1))))
        (fun clone h_1 =>
          Eq.ndrec (motive := fun x => labelAt true h (cols 1) = x → Nonanchor x) (fun he => True.intro) (Eq.symm h_1)
            (Eq.refl (labelAt true h (cols 1))))
        (Eq.refl (labelAt true h (cols 1)));
    unpinned_copy_localization h rows cols hc hn
