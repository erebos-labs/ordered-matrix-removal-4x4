def OrderedMatrixRemoval4.Host.PenultimateRepair.repairedMatrix : (h : Nat) → BinaryMatrix (Host.size h) :=
fun h r c => if repairCell h r c = true then false else Host.matrix h r c
def OrderedMatrixRemoval4.Host.PenultimateRepair.repairCell : (h : Nat) →
  Fin (Host.size h) → Fin (Host.size h) → Bool :=
fun h r c =>
  match Host.labelAt false h r, Host.labelAt true h c with
  | Host.Position.dummy clone, Host.Position.variable depth false node clone_1 => decide (depth = h - 1)
  | x, x_1 => false
def OrderedMatrixRemoval4.Host.PenultimateRepair.rows : Fin 4 → Fin (Host.size 4) :=
fun i =>
  match ↑i with
  | 0 => ⟨800, rows._proof_1⟩
  | 1 => ⟨802, rows._proof_2⟩
  | 2 => ⟨804, rows._proof_3⟩
  | x => ⟨912, rows._proof_4⟩
def OrderedMatrixRemoval4.Host.PenultimateRepair.cols : Fin 4 → Fin (Host.size 4) :=
fun i =>
  match ↑i with
  | 0 => ⟨836, cols._proof_1⟩
  | 1 => ⟨864, cols._proof_2⟩
  | 2 => ⟨868, cols._proof_3⟩
  | x => ⟨880, cols._proof_4⟩
