def OrderedMatrixRemoval4.Host.TerminalAnchorRepair.TerminalColumn : Nat → Position → Prop :=
fun h x =>
  match x with
  | Position.anchor l k g clone => l = h ∧ (k = 4 ∨ k = 5) ∧ g = 0
  | x => False
def OrderedMatrixRemoval4.Host.TerminalAnchorRepair.matrix : (h : Nat) → BinaryMatrix (size h) :=
fun h r c => if TerminalColumn h (labelAt true h c) ∧ Nonanchor (labelAt false h r) then false else Host.matrix h r c
